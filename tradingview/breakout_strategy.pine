//@version=6
// Session breakout strategy - the rules in trading-rules.md, for TradingView.
//
// HOW TO USE
// 1. Open a 5-minute chart of MNQ1! (micro Nasdaq) or MGC1! (micro gold).
// 2. Pine Editor (bottom of the screen) > paste this whole file > Save > Add to chart.
// 3. The Strategy Tester tab shows every trade it would have taken, and it
//    keeps adding new trades live as each session plays out. That is your
//    paper trading record on TradingView. On the chart you see the buy and
//    sell arrows, plus the entry (blue), stop (red) and targets (green).
// 4. Alerts: Alerts (clock icon) > Create alert > Condition: this strategy,
//    "Order fills and alert() function calls" > Notifications: tick "Notify
//    in app" (phone) and/or "Send email" > Create. Leave the message as
//    {{strategy.order.alert_message}}. You get one alert per buy and sell.
// The script picks Nasdaq or gold settings from the chart symbol.
//
// THE RULES (same as main.py)
// - Key levels: the high and low of the 2 hours before the open
//   (Nasdaq 7:30-9:30 AM New York, gold 7:00-9:00 AM Tokyo = 6-8 PM New York
//   in summer). The "Key levels" setting switches back to the previous
//   full session's high and low (the original rule; use a 30-minute window).
//     Nasdaq: New York, 9:30 AM to 4:00 PM New York time.
//     Gold:   Tokyo, 9:00 AM to 5:00 PM Tokyo time (8 PM / 7 PM New York).
// - In the first 60 minutes, a 5-minute candle closes beyond a key level,
//   and the NEXT candle also closes beyond it. Enter at that second close.
// - Stop: the far end of the two candles.
// - 3 targets, each 30 points (Nasdaq) or 6 points (gold) apart.
//   Sell 1 / 2 / 2 contracts. At Target 2 the stop moves to Target 1.
// - At most one trade per session. Anything still open at the session end
//   is closed.
// - Near the limit: when a closed trade leaves less than $1,500 of room before
//   the max drawdown, no new trade until the next 9:30 AM New York (orange
//   background), then 1 contract per target until the room is back above
//   $1,500. A trade whose stop would lose more than the room left is skipped.
// - Max drawdown $4,000: if the balance (closed trades) falls that far below
//   its highest end-of-day balance, no more trades are taken. Note that
//   TradingView applies this per chart, while the paper trader applies it to
//   both markets together.
//
// One difference from main.py: when a single candle touches both the stop
// and a target, TradingView guesses the order from the candle's shape, while
// main.py always assumes the stop was hit first.

// Futures need only a small deposit (margin) per contract, so margin checks
// are turned off. Without this, TradingView rejects every order because the
// contracts are worth more than the account balance.
strategy("Session Breakout (ai-trading-agent)", overlay = true,
     process_orders_on_close = true, pyramiding = 0,
     initial_capital = 50000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 5,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.0)

// ---------------- SETTINGS ----------------
market     = input.string("Auto", "Market", options = ["Auto", "Nasdaq", "Gold"])
levelMode  = input.string("2 hours before the open", "Key levels", options = ["2 hours before the open", "Previous session"])
windowMin  = input.int(60, "Look for breakouts this many minutes after the open", minval = 5)
confirm    = input.bool(true, "Wait for a second candle to confirm")
goldPlan1  = input.int(1, "Gold: contracts to sell at Target 1", minval = 1, maxval = 3)
goldPlan2  = input.int(2, "Gold: contracts to sell at Target 2", minval = 1, maxval = 3)
goldPlan3  = input.int(2, "Gold: contracts to sell at Target 3", minval = 1, maxval = 3)
showLevels = input.bool(true, "Draw the key levels")
showTrade  = input.bool(true, "Draw entry, stop and targets while a trade is open")
alertStyle = input.string("Readable", "Alert messages", options = ["Readable", "JSON (for a webhook)"])
maxDD      = input.float(4000, "Max drawdown ($): stop trading if the balance falls this far below its highest end-of-day balance", minval = 0)
nearLimit  = input.float(1500, "Near the limit ($): with less room than this, pause until the next 9:30 AM New York, then trade 1 contract per target", minval = 0)
// ------------------------------------------

if timeframe.period != "5"
    runtime.error("Use a 5-minute chart. The rules are written for 5-minute candles.")

root    = syminfo.root
isGold  = market == "Gold" or (market == "Auto" and (root == "MGC" or root == "GC"))
sessStr = isGold ? "0900-1700:23456" : "0930-1600:23456"
preStr  = isGold ? "0700-0900:23456" : "0730-0930:23456"
zone    = isGold ? "Asia/Tokyo" : "America/New_York"
spacing = isGold ? 6.0 : 30.0
q1      = isGold ? goldPlan1 : 1
q2      = isGold ? goldPlan2 : 2
q3      = isGold ? goldPlan3 : 2
total   = q1 + q2 + q3

inSess   = not na(time(timeframe.period, sessStr, zone))
newSess  = inSess and not inSess[1]
inPre    = not na(time(timeframe.period, preStr, zone))
newPre   = inPre and not inPre[1]
usePre   = levelMode == "2 hours before the open"

var float curHigh   = na
var float curLow    = na
var float prevHigh  = na
var float prevLow   = na
var int   sessStart = 0
var int   sessEnd   = 0
var bool  traded    = false
var int   pending   = 0      // 1 = long breakout waiting for confirmation, -1 = short
var float pendHigh  = na
var float pendLow   = na
var float entryPx   = na
var int   dir       = 0
var bool  stopMoved = false
var int   sessBars  = 0      // candles seen in the current session
var float preHigh   = na
var float preLow    = na
var int   preBars   = 0
if newPre
    preHigh := high
    preLow  := low
    preBars := 1
else if inPre
    preHigh := math.max(preHigh, high)
    preLow  := math.min(preLow, low)
    preBars := preBars + 1
fullBars = (isGold ? 480 : 390) / 5 * 0.75   // shorter sessions are holiday half-days

if newSess
    // A holiday half-day (like Labor Day) is not used as the previous session.
    if usePre
        // At least half of the 24 pre-open candles are needed.
        prevHigh := preBars >= 12 and not na(preHigh) ? preHigh : na
        prevLow  := preBars >= 12 and not na(preLow) ? preLow : na
        preBars  := 0
    else if not na(curHigh) and sessBars >= fullBars
        prevHigh := curHigh
        prevLow  := curLow
    sessBars  := 1
    curHigh   := high
    curLow    := low
    sessStart := time
    sessEnd   := time + (isGold ? 480 : 390) * 60000
    traded    := false
    pending   := 0
    stopMoved := false
else if inSess
    sessBars := sessBars + 1
    curHigh := math.max(curHigh, high)
    curLow  := math.min(curLow, low)

// ---- Max drawdown (trading days start at 6 PM New York) ----
var float peakEOD = strategy.initial_capital
var bool  halted  = false
closedBalance = strategy.initial_capital + strategy.netprofit
tradingDay = dayofmonth(time + 6 * 3600000, "America/New_York")
if tradingDay != tradingDay[1]
    peakEOD := math.max(peakEOD, nz(closedBalance[1], strategy.initial_capital))
if not halted and closedBalance <= peakEOD - maxDD
    halted := true

// ---- Near the max drawdown: pause until the next morning, then trade small ----
room = maxDD - (peakEOD - closedBalance)
var int pausedUntil = 0
if strategy.closedtrades > nz(strategy.closedtrades[1]) and not halted and room < nearLimit
    nyYear  = year(time, "America/New_York")
    nyMonth = month(time, "America/New_York")
    nyDay   = dayofmonth(time, "America/New_York")
    // An evening (gold) session counts from its own calendar day too:
    // "the next morning" is always the next 9:30 AM New York.
    pausedUntil := timestamp("America/New_York", nyYear, nyMonth, nyDay, 9, 30) + 86400000
paused  = time < pausedUntil
reduced = room < nearLimit
sz1 = reduced ? 1 : q1
sz2 = reduced ? 1 : q2
sz3 = reduced ? 1 : q3
szTotal = sz1 + sz2 + sz3
var int tradeQ3 = 0          // contracts for Target 3 in the open trade

inWindow = inSess and (time - sessStart) < windowMin * 60000
haveLevels = not na(prevHigh)

// Levels of the open trade, for drawing
var float entryLvl = na
var float stopLvl  = na
var float t1Lvl    = na
var float t2Lvl    = na
var float t3Lvl    = na

px(float p) => str.tostring(p, format.mintick)
readable = alertStyle == "Readable"
// Message when an exit order fills: at its target (win) or at the stop.
winMsg(string tgt, int q, float lvl) =>
    readable ? syminfo.ticker + " paper: " + tgt + " hit, sold " + str.tostring(q) + " at " + px(lvl) : '{"action":"exit","symbol":"' + syminfo.ticker + '","target":"' + tgt + '","qty":' + str.tostring(q) + '}'
stopMsg(string tgt, int q, float lvl) =>
    readable ? syminfo.ticker + " paper: stop hit, closed " + str.tostring(q) + " at " + px(lvl) + " (" + tgt + " order)" : '{"action":"stop","symbol":"' + syminfo.ticker + '","qty":' + str.tostring(q) + '}'

enterTrade(int d, float stopPx) =>
    entry = close
    // Near the limit, skip a trade whose stop would lose more than the room left.
    riskUsd = math.abs(entry - stopPx) * syminfo.pointvalue * szTotal
    if math.abs(entry - stopPx) > 0 and not (reduced and riskUsd >= room)
        t1 = entry + d * spacing
        t2 = entry + d * 2 * spacing
        t3 = entry + d * 3 * spacing
        id = d == 1 ? "Long" : "Short"
        enterMsg = readable ? syminfo.ticker + " paper: " + (d == 1 ? "BUY " : "SELL SHORT ") + str.tostring(szTotal) + (reduced ? " (small size)" : "") + " at " + px(entry) + ", stop " + px(stopPx) + ", targets " + px(t1) + " / " + px(t2) + " / " + px(t3) : '{"action":"' + (d == 1 ? "buy" : "sell") + '","symbol":"' + syminfo.ticker + '","qty":' + str.tostring(szTotal) + ',"stop":' + str.tostring(stopPx) + '}'
        strategy.entry(id, d == 1 ? strategy.long : strategy.short, qty = szTotal, alert_message = enterMsg)
        strategy.exit("T1", id, qty = sz1, limit = t1, stop = stopPx,
             alert_profit = winMsg("Target 1", sz1, t1), alert_loss = stopMsg("T1", sz1, stopPx))
        strategy.exit("T2", id, qty = sz2, limit = t2, stop = stopPx,
             alert_profit = winMsg("Target 2", sz2, t2), alert_loss = stopMsg("T2", sz2, stopPx))
        strategy.exit("T3", id, qty = sz3, limit = t3, stop = stopPx,
             alert_profit = winMsg("Target 3", sz3, t3), alert_loss = stopMsg("T3", sz3, stopPx))
        true
    else
        false

// ---- Entries ----
if inSess and haveLevels and not traded and not halted and not paused and strategy.position_size == 0
    handled = false
    if confirm and pending != 0
        stillBeyond = pending == 1 ? close > prevHigh : close < prevLow
        if stillBeyond
            stopPx = pending == 1 ? math.min(pendLow, low) : math.max(pendHigh, high)
            if enterTrade(pending, stopPx)
                traded  := true
                dir     := pending
                entryPx := close
                entryLvl := close
                stopLvl  := stopPx
                t1Lvl    := close + pending * spacing
                t2Lvl    := close + pending * 2 * spacing
                t3Lvl    := close + pending * 3 * spacing
                tradeQ3  := sz3
            handled := true
        pending := 0
    if not handled and not traded and inWindow
        breakout = close > prevHigh ? 1 : close < prevLow ? -1 : 0
        if breakout != 0
            if confirm
                pending  := breakout
                pendHigh := high
                pendLow  := low
            else
                stopPx = breakout == 1 ? low : high
                if enterTrade(breakout, stopPx)
                    traded  := true
                    dir     := breakout
                    entryPx := close
                    entryLvl := close
                    stopLvl  := stopPx
                    t1Lvl    := close + breakout * spacing
                    t2Lvl    := close + breakout * 2 * spacing
                    t3Lvl    := close + breakout * 3 * spacing
                    tradeQ3  := sz3

// ---- Manage the open trade: after Target 2, move the stop to Target 1 ----
if strategy.position_size != 0 and not stopMoved and math.abs(strategy.position_size) <= tradeQ3
    t1 = entryPx + dir * spacing
    t3 = entryPx + dir * 3 * spacing
    strategy.exit("T3", dir == 1 ? "Long" : "Short", qty = tradeQ3, limit = t3, stop = t1,
         alert_profit = winMsg("Target 3", tradeQ3, t3), alert_loss = stopMsg("T3", tradeQ3, t1))
    stopLvl   := t1
    stopMoved := true

// ---- Close anything still open at the end of the session ----
if strategy.position_size != 0 and inSess and time_close >= sessEnd
    strategy.close_all(comment = "Session end",
         alert_message = readable ? syminfo.ticker + " paper: session ended, closed the rest at " + px(close) : '{"action":"close_all","symbol":"' + syminfo.ticker + '"}')

plot(showLevels ? prevHigh : na, "Key high", color.new(color.green, 0), 1, plot.style_linebr)
plot(showLevels ? prevLow  : na, "Key low",  color.new(color.red, 0),   1, plot.style_linebr)
bgcolor(inWindow ? color.new(color.blue, 90) : na, title = "Entry window")

// The open trade: entry (blue), stop (red, moves to Target 1 after Target 2),
// targets (green). Buys and sells are marked by TradingView's own trade arrows.
inTrade = showTrade and (strategy.position_size != 0 or nz(strategy.position_size[1]) != 0)
plot(inTrade ? entryLvl : na, "Entry",    color.new(color.blue, 0),  2, plot.style_linebr)
plot(inTrade ? stopLvl  : na, "Stop",     color.new(color.red, 0),   2, plot.style_linebr)
plot(inTrade ? t1Lvl    : na, "Target 1", color.new(color.green, 30), 1, plot.style_linebr)
plot(inTrade ? t2Lvl    : na, "Target 2", color.new(color.green, 15), 1, plot.style_linebr)
plot(inTrade ? t3Lvl    : na, "Target 3", color.new(color.green, 0),  2, plot.style_linebr)
bgcolor(halted ? color.new(color.red, 92) : na, title = "Stopped by max drawdown")
bgcolor(not halted and paused ? color.new(color.orange, 90) : na, title = "Paused near max drawdown")
